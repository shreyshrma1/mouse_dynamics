# Ignore everything by default
*

# Unignore the .gitignore itself
!.gitignore

# shen_model — keep only scroll-related scripts
!shen_model/
shen_model/*
!shen_model/shen_replication_scroll.py
!shen_model/train_from_existing_shen_scroll.py
!shen_model/evaluate_shen_scroll_user.py

# measurements — keep only scroll feature extractor
!measurements/
measurements/*
!measurements/extract_features_scroll.py

# data_collection — keep only the listed scripts
!data_collection/
data_collection/*
!data_collection/auth_sim.py
!data_collection/bank_vs_bank_1d.py
!data_collection/bank_vs_bank_2d.py
!data_collection/continual_trainer.py
!data_collection/eval_continuous_auth.py

# bank_collection — keep everything
!bank_collection/
!bank_collection/**
